# Shell & Co Remodel Studio — Build Room 02
# PLACEHOLDERS ONLY. Never commit real secret values.

# Browser-safe/public configuration (only after dedicated project exists)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Edge Function secrets — configure in Supabase secret storage, never browser/GitHub
OPENAI_API_KEY=REPLACE_IN_SECRET_STORE_ONLY
BR02_OPENAI_ENABLED=false
BR02_KILL_SWITCH=true
BR02_MONTHLY_BUDGET_USD=20
BR02_RESERVED_COST_PER_CALL_USD=0.08
BR02_IP_HASH_SALT=REPLACE_WITH_RANDOM_SECRET_IN_SECRET_STORE
BR02_ALLOWED_ORIGIN=https://aicapitalventures.github.io
BR02_RESULT_URL_TTL_SECONDS=60
BR02_SOURCE_BUCKET=remodel-source-private
BR02_RESULT_BUCKET=remodel-results-private

# Future scheduled purge secret (do not expose to browser)
BR02_CLEANUP_SECRET=REPLACE_WITH_RANDOM_SECRET_IN_SECRET_STORE
